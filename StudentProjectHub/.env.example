# Copy this file to .env and fill in real values. Never commit the real .env.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# Database. Leave as-is for local dev (SQLite, no setup needed).
# In production, set this to your managed Postgres connection string instead
# (e.g. from Neon - use the pooled connection string, hostname contains "-pooler").
DATABASE_URL=sqlite:///../instance/studentprojecthub.db

# File uploads
MAX_CONTENT_LENGTH_MB=25

# S3-compatible object storage (AWS S3, Cloudflare R2, DigitalOcean Spaces...).
# Leave S3_BUCKET blank for local dev - files save to ./uploads on disk instead.
# Required in production on platforms like Render/Railway, which wipe local
# disk on every deploy/restart.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto
# Public base URL for the bucket (needed so profile avatars keep working long-term -
# without this, avatars fall back to a presigned URL that expires after 7 days).
S3_PUBLIC_BASE_URL=

# Razorpay (get test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=yourkeysecret

# Admin bootstrap account (created automatically on first run if no admin exists)
ADMIN_EMAIL=admin@studentprojecthub.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Site Admin

